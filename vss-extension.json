{
  "manifestVersion": 1,
  "id": "Test-Analysis",
  "version": "2.0.31",
  "name": "Test Plan Analysis",
  "description": "Interactive Test Plan Analysis — modern React UI.",
  "publisher": "AviHadad",
  "public": true,
  "categories": [
    "Test"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services",
      "version": "[16.0,)"
    }
  ],
  "icons": {
    "default": "images/logo.png"
  },
  "contributions": [
    {
      "id": "Test_Analysis",
      "type": "ms.vss-web.hub",
      "description": "Test Plan Analysis hub",
      "targets": [
        "ms.vss-test-web.test-hub-group"
      ],
      "properties": {
        "name": "Analysis",
        "order": 99,
        "uri": "dist/Hub/Hub.html"
      }
    }
  ],
  "scopes": [
    "vso.work",
    "vso.test",
    "vso.test_write"
  ],
  "tags": [
    "Test Plan",
    "Tests",
    "Analysis",
    "Graphs",
    "Hub"
  ],
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    }
  ]
}
